<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Sonora" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">@color/sonora_primary</item>
        <item name="android:statusBarColor">@color/sonora_background</item>
        <item name="android:navigationBarColor">@color/sonora_background</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowSplashScreenBackground">@color/sonora_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
        <item name="android:windowSplashScreenBrandingImage">@drawable/sonara_branding_horizontal</item>
        <item name="android:windowSplashScreenAnimationDuration">500</item>
    </style>
</resources>
